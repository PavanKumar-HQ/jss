# JSS Publications Production Environment Variables Template

# Server Configuration
PORT=3001
NODE_ENV=development

# Database Configuration (Defaults to persistent SQLite 3 in server/data/)
DATABASE_PATH=server/data/jss_publications.db

# Payment Gateway (Razorpay / UPI)
# If left empty, system runs with full postal V.P.P. and counter collection
# and explicitly outputs "PAYMENT NOT CONFIGURED" without simulating success.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Security & Authentication
ADMIN_JWT_SECRET=jss_granthamale_production_secret_key_2026

# India Post Speed Post API (Optional)
INDIA_POST_CLIENT_ID=
INDIA_POST_CLIENT_SECRET=
